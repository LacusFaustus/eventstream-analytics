{
  "dashboard": {
    "title": "EventStream Analytics",
    "uid": "analytics-dashboard",
    "panels": [
      {
        "id": 1,
        "title": "Daily Active Users (DAU)",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(daily_active_users)",
            "legendFormat": "DAU"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null }
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Events Per Second",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(events_total[5m])",
            "legendFormat": "Events/s"
          }
        ]
      },
      {
        "id": 3,
        "title": "Events by Category",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum(events_by_category)",
            "legendFormat": "{{category}}"
          }
        ]
      }
    ],
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "refresh": "1m"
  }
}